// FUTURE database schema. Not connected to the design prototype.
// Run migrations only after approved PostgreSQL credentials, backups and auth integration.
generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { OWNER EDITOR VIEWER }
enum ProjectStatus { DRAFT PUBLISHED ARCHIVED }
enum LeadStatus { NEW IN_PROGRESS CLOSED SPAM }
enum LeadKind { CONSULTATION ESTIMATE CATALOG GENERAL }
enum ReviewStatus { PENDING APPROVED REJECTED }
enum MediaKind { IMAGE VIDEO DOCUMENT }

model AdminUser {
 id String @id @default(cuid())
 email String @unique
 name String?
 role Role @default(VIEWER)
 isActive Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 auditLogs AuditLog[]
}

model Project {
 id String @id @default(cuid())
 slug String @unique
 title String
 subtitle String?
 description String @db.Text
 category String?
 style String?
 publicationStatus ProjectStatus @default(DRAFT)
 sortOrder Int @default(0)
 isConcept Boolean @default(false)
 seoTitle String?
 seoDescription String? @db.VarChar(300)
 coverMediaId String?
 publishedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 media ProjectMedia[]
 @@index([publicationStatus,sortOrder])
}

model MediaAsset {
 id String @id @default(cuid())
 kind MediaKind @default(IMAGE)
 storageKey String @unique
 url String
 alt String @default("")
 originalName String?
 mimeType String
 width Int?
 height Int?
 sizeBytes Int
 checksum String? @unique
 createdAt DateTime @default(now())
 projectMedia ProjectMedia[]
}

model ProjectMedia {
 projectId String
 mediaId String
 role String @default("gallery")
 sortOrder Int @default(0)
 project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
 media MediaAsset @relation(fields:[mediaId],references:[id],onDelete:Restrict)
 @@id([projectId,mediaId])
 @@index([projectId,sortOrder])
}

model Lead {
 id String @id @default(cuid())
 name String
 phone String
 email String?
 message String? @db.Text
 kind LeadKind @default(GENERAL)
 status LeadStatus @default(NEW)
 consentVersion String
 consentGivenAt DateTime
 assignedToEmail String?
 internalNotes String? @db.Text
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status,createdAt])
}

model Review {
 id String @id @default(cuid())
 name String
 rating Int
 comment String @db.Text
 status ReviewStatus @default(PENDING)
 consentVersion String
 consentGivenAt DateTime
 moderatedBy String?
 publishedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status,createdAt])
}

model ContentPage {
 id String @id @default(cuid())
 slug String @unique
 title String
 sectionData Json
 status ProjectStatus @default(DRAFT)
 seoTitle String?
 seoDescription String?
 updatedAt DateTime @updatedAt
}

model SiteSetting {
 key String @id
 value Json
 updatedAt DateTime @updatedAt
}

model AuditLog {
 id String @id @default(cuid())
 adminUserId String
 action String
 entityType String
 entityId String
 before Json?
 after Json?
 createdAt DateTime @default(now())
 adminUser AdminUser @relation(fields:[adminUserId],references:[id])
 @@index([entityType,entityId,createdAt])
}
